{
  "name": "dsh-poke",
  "version": "1.0.0",
  "description": "DSH 插件：agent 提问时自动把 DSH App 顶到前台，失败则发通知兜底。Focused foreground + notification fallback for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "poke",
    "notify"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fssama/dsh-poke.git"
  },
  "bugs": {
    "url": "https://github.com/fssama/dsh-poke/issues"
  },
  "homepage": "https://github.com/fssama/dsh-poke#readme"
}
